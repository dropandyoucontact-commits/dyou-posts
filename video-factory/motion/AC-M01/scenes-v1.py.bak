son(T_COEUR - 0.15, "whoosh_bas", -8); son(T_PREVENIR - 0.05, "impact", -6)
son(T_PERSOS[0] - 0.3, "whoosh", -9)
for t0 in T_PERSOS: son(t0 - 0.08, "pop", -9)
son(T_ROLES - 0.1, "montee", -11); son(T_EMMY - 0.06, "ching", -8)
son(T_PIVOT - 0.22, "whoosh_long", -7); son(TW(43) - 0.06, "impact_doux", -6)
son(T_FILM - 0.2, "whoosh", -9); son(T_ENTERRE - 0.05, "impact", -5)
son(T_JAMAIS - 0.06, "ching", -8)
son(T_SUPPLIE - 0.22, "whoosh_long", -8); son(T_PUBLIC - 0.08, "pop", -10)
son(T_SCENE - 0.08, "pop", -10); son(T_DAFFY - 0.2, "swipe", -10)
son(T_CEDE - 0.1, "impact", -4); son(T_CEDE + 0.08, "ching", -8)
son(T_SORTI - 0.06, "check", -9); son(T_CENT - 0.08, "montee", -10)
son(T_GAGNE - 0.1, "impact", -4); son(T_GAGNE + 0.05, "ching", -7)
son(T_MOIS - 0.1, "whoosh_bas", -9); son(T_VA - 0.08, "swipe", -11)
son(T_VEILLE - 0.2, "whoosh", -9); son(T_SOURIAIT - 0.06, "pop", -9)
son(T_CTA - 0.2, "whoosh_long", -7); son(T_CTA + 0.05, "ching", -8)
son(T_COMMENTAIRE + 0.25, "pop", -9)
son(T_FIN - 1.3, "montee", -11); son(T_FIN - 1.1, "impact", -4)

for a, b in [(0.0, 0.5), (T_NOM - 0.15, T_NOM + 0.3), (T_PERSOS[0] - 0.3, T_PERSOS[0] + 0.2),
             (T_PIVOT - 0.22, T_PIVOT + 0.3), (T_FILM - 0.2, T_FILM + 0.25),
             (T_ENTERRE - 0.1, T_ENTERRE + 0.3), (T_SUPPLIE - 0.22, T_SUPPLIE + 0.3),
             (T_CEDE - 0.1, T_CEDE + 0.4), (T_GAGNE - 0.1, T_GAGNE + 0.4),
             (T_VEILLE - 0.2, T_VEILLE + 0.3), (T_CTA - 0.2, T_CTA + 0.4)]:
    rapide(a, b)
for tt, cc_, a_ in [(0.02, "#FFFFFF", 0.10), (T_NOM, ORANGE, 0.12), (T_PREVENIR, "#FFFFFF", 0.13),
                    (T_ENTERRE, ORANGE, 0.10), (T_CEDE, "#FFFFFF", 0.13), (T_GAGNE, ORANGE, 0.12),
                    (T_CTA, ORANGE, 0.10)]:
    eclair(tt, cc_, a_)


# ═════════════════════════════ composition
def dessine(c, t):
    agence.T_COURANT[0] = t
    pulse = (battement(t, T_NOM, 1, 0.5) - 1) + (battement(t, T_CEDE, 1, 0.5) - 1) + (battement(t, T_GAGNE, 1, 0.5) - 1)
    fond_cobalt(c, t, pulse)
    hook(c, t); identite(c, t); ecg(c, t); personnages(c, t); pivot(c, t)
    enterre(c, t); supplie(c, t); cedent(c, t); gagne(c, t); veille(c, t); cta(c, t)
    K.dessine_eclairs(c, t)
    SOUS.dessine(c, t, "#FFFFFF")
