# ═════════════════════════════ composition
def dessine(c, t):
    pulse = (battement(t, T_NOM, 1, 0.5) - 1) + (battement(t, T_CEDE, 1, 0.5) - 1) \
          + (battement(t, T_GAGNE, 1, 0.5) - 1)
    fond_grille(c, t, pulse, vitesse=vitesse_grille(t))
    hook(c, t); identite(c, t); ecg(c, t); personnages(c, t); pivot(c, t)
    enterre(c, t); supplie(c, t); cedent(c, t); gagne(c, t); veille(c, t); cta(c, t)
    if t >= T_SIGN - 0.12:
        signature_people(c, t, T_SIGN, MEDIAS)
    filigrane(c, 0.22 * (1 - prog(t, T_SIGN - 0.2, 0.2, entree)))
    K.dessine_eclairs(c, t)
    if t < T_SIGN - 0.02:
        SOUS.dessine(c, t, ENCRE)
